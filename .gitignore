# Agent tooling state, not project source. Without this, `git add -A` tries to
# stage ~2000 bundled skill files and the checkpoint capture fails.
.claude/
.impeccable/
.planning/

# Reserved device name on Windows. git lists the directory entry but any read
# resolves to the null device, so indexing it dies with "short read" and takes
# the whole `git add` down with exit 128. Unreadable and undeletable by normal
# means, so ignoring is the only fix.
nul

# Phase 0 probe artifacts: generated embeddings and local wrangler state
ask-sankalp/probe/vectors.ndjson
.wrangler/
